@page
@model Assessment_Agit.Pages.Requests.AllModel
@{
    ViewData["Title"] = "All Requests & Audit";
}

<div class="card card-shadow border-0 bg-white p-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h4 class="fw-bold mb-1">Global Requests & Audit Overview</h4>
            <p class="text-muted small mb-0">Auditor view (e.g., <strong>Erin</strong>) showing all access requests and approval workflows</p>
        </div>
        <span class="badge bg-secondary px-3 py-2">@Model.AllRequests.Count Total Requests</span>
    </div>

    @if (Model.AllRequests.Count == 0)
    {
        <div class="text-center py-5">
            <div class="display-6 text-muted mb-3">📁</div>
            <h5 class="fw-semibold">No requests in database</h5>
            <p class="text-muted small">No access requests have been created yet.</p>
            <a asp-page="/Requests/Create" class="btn btn-primary btn-sm">Create Request</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Requester</th>
                        <th>Application</th>
                        <th>Env / Access</th>
                        <th>Status</th>
                        <th>Risk</th>
                        <th>Policy</th>
                        <th>Events</th>
                        <th>Created</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.AllRequests)
                    {
                        <tr>
                            <td>
                                <strong>@r.RequesterName</strong>
                                <small class="d-block text-muted">@r.RequesterEmail</small>
                            </td>
                            <td>
                                <strong>@r.ApplicationName</strong>
                                <small class="d-block text-muted">@r.ApplicationCode</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@r.Environment</span>
                                <span class="badge bg-light text-dark border">@r.AccessLevel</span>
                            </td>
                            <td>
                                @if (r.Status == RequestStatus.PendingManager)
                                {
                                    <span class="badge bg-warning text-dark">Pending Manager</span>
                                }
                                else if (r.Status == RequestStatus.PendingSystemOwner)
                                {
                                    <span class="badge bg-info text-dark">Pending System Owner</span>
                                }
                                else if (r.Status == RequestStatus.Approved)
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else if (r.Status == RequestStatus.Rejected)
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                }
                            </td>
                            <td>
                                @if (r.IsHighRisk)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">High-Risk</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Standard</span>
                                }
                            </td>
                            <td>
                                <code>@r.PolicyVersion</code>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@r.AuditLogs.Count</span>
                            </td>
                            <td>
                                <small class="text-muted">@r.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                            </td>
                            <td class="text-end">
                                <a asp-page="/Requests/Detail" asp-route-id="@r.Id" class="btn btn-outline-primary btn-sm">
                                    View Audit &rarr;
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

