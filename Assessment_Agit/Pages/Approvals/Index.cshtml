@page
@model Assessment_Agit.Pages.Approvals.IndexModel
@{
    ViewData["Title"] = "Approval Inbox";
}

<div class="card card-shadow border-0 bg-white p-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h4 class="fw-bold mb-1">Approval Inbox</h4>
            <p class="text-muted small mb-0">Pending requests awaiting decision by <strong>@Model.CurrentUser?.FullName</strong> (@Model.CurrentUser?.Role)</p>
        </div>
        <span class="badge bg-primary px-3 py-2">@Model.PendingRequests.Count Actionable Items</span>
    </div>

    @if (Model.PendingRequests.Count == 0)
    {
        <div class="text-center py-5">
            <div class="display-6 text-muted mb-3">✨</div>
            <h5 class="fw-semibold">No pending approvals</h5>
            <p class="text-muted small">
                There are currently no access requests waiting for your approval as <strong>@Model.CurrentUser?.Role</strong>.<br />
                Switch to <strong>Bob</strong> (Manager) or <strong>Carol / Dana</strong> (System Owners) using the User Switcher above to view actionable tasks.
            </p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Requester</th>
                        <th>Target App</th>
                        <th>Env / Access</th>
                        <th>Stage</th>
                        <th>Risk Profile</th>
                        <th>Submitted</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.PendingRequests)
                    {
                        <tr>
                            <td>
                                <strong>@r.RequesterName</strong>
                                <small class="d-block text-muted">@r.RequesterEmail</small>
                            </td>
                            <td>
                                <strong>@r.ApplicationName</strong>
                                <small class="d-block text-muted">@r.ApplicationCode</small>
                            </td>
                            <td>
                                <div><span class="badge bg-light text-dark border">@r.Environment</span></div>
                                <div class="mt-1"><span class="badge bg-light text-dark border">@r.AccessLevel</span></div>
                            </td>
                            <td>
                                @if (r.Status == RequestStatus.PendingManager)
                                {
                                    <span class="badge bg-warning text-dark">Stage 1: Manager Review</span>
                                }
                                else if (r.Status == RequestStatus.PendingSystemOwner)
                                {
                                    <span class="badge bg-info text-dark">Stage 2: System Owner Review</span>
                                }
                            </td>
                            <td>
                                @if (r.IsHighRisk)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">High-Risk (2-Stage)</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Standard (1-Stage)</span>
                                }
                            </td>
                            <td>
                                <small class="text-muted">@r.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-success" 
                                            onclick="openQuickApproveModal('@r.Id', '@r.RequesterName', '@r.ApplicationName', @r.RowVersion, @(r.IsHighRisk ? "true" : "false"))">
                                        ✅ Approve
                                    </button>
                                    <button type="button" class="btn btn-outline-danger" 
                                            onclick="openQuickRejectModal('@r.Id', '@r.RequesterName', '@r.ApplicationName', @r.RowVersion)">
                                        ❌ Reject
                                    </button>
                                    <a asp-page="/Requests/Detail" asp-route-id="@r.Id" class="btn btn-outline-primary">
                                        Detail &rarr;
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Quick Approve Modal -->
<div class="modal fade" id="quickApproveModal" tabindex="-1" aria-labelledby="quickApproveModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold" id="quickApproveModalLabel">✅ Quick Approve Access Request</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="quickApproveRequestId" />
                <input type="hidden" id="quickApproveRowVersion" />
                <p>Are you sure you want to approve this access request?</p>
                <div class="p-3 bg-light rounded border small mb-3">
                    <div><strong>Requester:</strong> <span id="quickApproveRequester"></span></div>
                    <div><strong>Application:</strong> <span id="quickApproveApp"></span></div>
                    <div id="quickApproveRiskNotice" class="text-danger mt-1 fw-semibold d-none">
                        ⚠️ High-Risk: Manager approval will escalate to System Owner.
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success px-4" onclick="executeQuickApprove()">
                    Confirm Approval
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Quick Reject Modal -->
<div class="modal fade" id="quickRejectModal" tabindex="-1" aria-labelledby="quickRejectModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold" id="quickRejectModalLabel">❌ Reject Access Request</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="quickRejectRequestId" />
                <input type="hidden" id="quickRejectRowVersion" />
                <p class="small text-muted mb-2">
                    Rejecting request for <strong id="quickRejectRequester"></strong> (<span id="quickRejectApp"></span>).
                </p>
                <div class="mb-3">
                    <label for="quickRejectReason" class="form-label fw-semibold">Rejection Reason <span class="text-danger">*</span></label>
                    <textarea class="form-control" id="quickRejectReason" rows="3" placeholder="Provide reason for rejection..." required></textarea>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4" onclick="executeQuickReject()">
                    Confirm Rejection
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openQuickApproveModal(id, requester, app, version, isHighRisk) {
            $('#quickApproveRequestId').val(id);
            $('#quickApproveRowVersion').val(version);
            $('#quickApproveRequester').text(requester);
            $('#quickApproveApp').text(app);

            if (isHighRisk) {
                $('#quickApproveRiskNotice').removeClass('d-none');
            } else {
                $('#quickApproveRiskNotice').addClass('d-none');
            }

            const modal = new bootstrap.Modal(document.getElementById('quickApproveModal'));
            modal.show();
        }

        function executeQuickApprove() {
            const id = $('#quickApproveRequestId').val();
            const version = parseInt($('#quickApproveRowVersion').val());

            Swal.fire({
                title: 'Processing Approval...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.ajax({
                url: `/api/requests/${id}/approve`,
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    rowVersion: version,
                    isApproved: true
                }),
                success: function(res) {
                    $('#quickApproveModal').modal('hide');
                    Swal.fire({
                        icon: 'success',
                        title: 'Approved!',
                        text: 'Access request has been approved successfully.',
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => {
                        location.reload();
                    });
                },
                error: function(xhr) {
                    Swal.fire({
                        icon: 'error',
                        title: `Approval Failed (${xhr.status})`,
                        html: xhr.responseJSON?.error || xhr.statusText
                    });
                }
            });
        }

        function openQuickRejectModal(id, requester, app, version) {
            $('#quickRejectRequestId').val(id);
            $('#quickRejectRowVersion').val(version);
            $('#quickRejectRequester').text(requester);
            $('#quickRejectApp').text(app);
            $('#quickRejectReason').val('');

            const modal = new bootstrap.Modal(document.getElementById('quickRejectModal'));
            modal.show();
        }

        function executeQuickReject() {
            const id = $('#quickRejectRequestId').val();
            const version = parseInt($('#quickRejectRowVersion').val());
            const reason = $('#quickRejectReason').val()?.trim();

            if (!reason) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Reason Required',
                    text: 'A rejection reason is mandatory by business rules.'
                });
                return;
            }

            Swal.fire({
                title: 'Processing Rejection...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.ajax({
                url: `/api/requests/${id}/reject`,
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    rowVersion: version,
                    isApproved: false,
                    rejectReason: reason
                }),
                success: function(res) {
                    $('#quickRejectModal').modal('hide');
                    Swal.fire({
                        icon: 'success',
                        title: 'Rejected',
                        text: 'Access request has been rejected.',
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => {
                        location.reload();
                    });
                },
                error: function(xhr) {
                    Swal.fire({
                        icon: 'error',
                        title: `Rejection Failed (${xhr.status})`,
                        html: xhr.responseJSON?.error || xhr.statusText
                    });
                }
            });
        }
    </script>
}
