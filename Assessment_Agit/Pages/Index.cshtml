@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-4">
    <!-- Welcome Card -->
    <div class="col-12">
        <div class="card card-shadow border-0 bg-white p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h3 class="fw-bold mb-1">Welcome, @Model.CurrentUser?.FullName</h3>
                    <p class="text-muted mb-0">
                        Email: <code>@Model.CurrentUser?.Email</code> &bull; Role: <span class="badge bg-primary">@Model.CurrentUser?.Role</span>
                        @if (Model.CurrentUser?.Manager != null)
                        {
                            <span> &bull; Direct Manager: <strong>@Model.CurrentUser.Manager.FullName</strong></span>
                        }
                    </p>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#globalNewRequestModal">
                        ➕ Submit Request
                    </button>
                    <a asp-page="/Approvals/Index" class="btn btn-outline-secondary position-relative">
                        📥 Approvals Inbox
                        @if (Model.PendingApprovals.Count > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                @Model.PendingApprovals.Count
                            </span>
                        }
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="col-md-4">
        <div class="card card-shadow border-0 p-3 bg-white">
            <div class="text-muted small fw-semibold text-uppercase">My Active Requests</div>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <h2 class="fw-bold mb-0 text-primary">@Model.MyRequests.Count</h2>
                <a asp-page="/Requests/Index" class="btn btn-sm btn-light">View all &rarr;</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-shadow border-0 p-3 bg-white">
            <div class="text-muted small fw-semibold text-uppercase">Pending Approvals For Me</div>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <h2 class="fw-bold mb-0 text-warning">@Model.PendingApprovals.Count</h2>
                <a asp-page="/Approvals/Index" class="btn btn-sm btn-light">Review &rarr;</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-shadow border-0 p-3 bg-white">
            <div class="text-muted small fw-semibold text-uppercase">High-Risk Policy Trigger</div>
            <p class="small text-muted mb-0 mt-2">
                <code>Environment == Production</code> <strong>OR</strong> <code>AccessLevel == Admin</code> triggers 2-stage approval (Manager &rarr; System Owner).
            </p>
        </div>
    </div>

    <!-- Demo Personas Guide Card -->
    <div class="col-lg-7">
        <div class="card card-shadow border-0 p-4 bg-white h-100">
            <h5 class="fw-bold mb-3">📋 Seeded Demo Users & Roles (Assessment Guide)</h5>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle datatable">
                    <thead class="table-light">
                        <tr>
                            <th>User</th>
                            <th>Role / Responsibility</th>
                            <th class="no-sort text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <strong>Alice</strong><br />
                                <small class="text-muted">alice@example.local</small>
                            </td>
                            <td>Requester. Direct report to Bob.</td>
                            <td>
                                <button class="btn btn-xs btn-outline-primary py-1 px-2" onclick="switchUser('11111111-1111-1111-1111-111111111111')">Switch</button>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <strong>Bob</strong><br />
                                <small class="text-muted">bob@example.local</small>
                            </td>
                            <td>Manager for Alice. Processes Manager approval.</td>
                            <td>
                                <button class="btn btn-xs btn-outline-primary py-1 px-2" onclick="switchUser('22222222-2222-2222-2222-222222222222')">Switch</button>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <strong>Carol</strong><br />
                                <small class="text-muted">carol@example.local</small>
                            </td>
                            <td>System Owner for <strong>CRM</strong>.</td>
                            <td>
                                <button class="btn btn-xs btn-outline-primary py-1 px-2" onclick="switchUser('33333333-3333-3333-3333-333333333333')">Switch</button>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <strong>Dana</strong><br />
                                <small class="text-muted">dana@example.local</small>
                            </td>
                            <td>System Owner for <strong>Finance Portal</strong>.</td>
                            <td>
                                <button class="btn btn-xs btn-outline-primary py-1 px-2" onclick="switchUser('44444444-4444-4444-4444-444444444444')">Switch</button>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <strong>Erin</strong><br />
                                <small class="text-muted">erin@example.local</small>
                            </td>
                            <td>Admin/Auditor. Views all requests and audit trails.</td>
                            <td>
                                <button class="btn btn-xs btn-outline-primary py-1 px-2" onclick="switchUser('55555555-5555-5555-5555-555555555555')">Switch</button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Workflow Architecture Diagram Card -->
    <div class="col-lg-5">
        <div class="card card-shadow border-0 p-4 bg-white h-100">
            <h5 class="fw-bold mb-3">🔄 Phase 1 Workflow State Machine</h5>
            <div class="p-3 bg-light rounded small">
                <div class="fw-semibold text-primary mb-1">1. Submission</div>
                <div class="mb-2 text-muted">&rarr; Status: <code>PendingManager</code></div>

                <div class="fw-semibold text-warning mb-1">2. Manager Review (Bob)</div>
                <ul class="mb-2 text-muted ps-3">
                    <li><strong>Reject:</strong> &rarr; <code>Rejected</code> (Terminal)</li>
                    <li><strong>Approve (Non-High-Risk):</strong> &rarr; <code>Approved</code> (Terminal)</li>
                    <li><strong>Approve (High-Risk):</strong> &rarr; <code>PendingSystemOwner</code></li>
                </ul>

                <div class="fw-semibold text-info mb-1">3. System Owner Review (Carol / Dana)</div>
                <ul class="mb-0 text-muted ps-3">
                    <li><strong>Reject:</strong> &rarr; <code>Rejected</code> (Terminal)</li>
                    <li><strong>Approve:</strong> &rarr; <code>Approved</code> (Terminal)</li>
                </ul>
            </div>
        </div>
    </div>
</div>

